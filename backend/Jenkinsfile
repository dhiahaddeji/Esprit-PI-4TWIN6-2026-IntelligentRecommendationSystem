pipeline {
    agent any

    tools {
        nodejs "nodejs"
    }

    environment {
        SONARQUBE_ENV  = "sonarqube"
        SONAR_TOKEN    = credentials("sonar-token")          // Jenkins credential ID
        SONAR_HOST     = "http://localhost:9000"
        DOCKER_IMAGE   = "dhiahaddeji/pi-back"
        DOCKER_TAG     = "${BUILD_NUMBER}"
    }

    stages {

        // ── 1. Clone ────────────────────────────────────────────────────────
        stage('Clone') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/abir-mosrati2/Esprit-PI-4TWIN6-2026-IntelligentRecommendationSystem.git'
            }
        }

        // ── 2. Install ──────────────────────────────────────────────────────
        stage('Install') {
            steps {
                sh 'npm ci'
            }
        }

        // ── 3. Test ─────────────────────────────────────────────────────────
        stage('Test') {
            steps {
                sh 'npm run test -- --coverage --forceExit'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'test-results/*.xml'
                }
            }
        }

        // ── 4. SonarQube Analysis ───────────────────────────────────────────
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv("${SONARQUBE_ENV}") {
                    sh """
                    npx sonar-scanner \
                      -Dsonar.projectKey=backend \
                      -Dsonar.projectName="PI Backend" \
                      -Dsonar.sources=src \
                      -Dsonar.exclusions=**/node_modules/**,**/dist/**,**/*.spec.ts,**/test/** \
                      -Dsonar.typescript.lcov.reportPaths=coverage/lcov.info \
                      -Dsonar.host.url=${SONAR_HOST} \
                      -Dsonar.token=${SONAR_TOKEN}
                    """
                }
            }
        }

        // ── 5. Quality Gate ─────────────────────────────────────────────────
        stage('Quality Gate') {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ── 6. Build (compile TypeScript) ───────────────────────────────────
        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }

        // ── 7. Docker Build & Push ──────────────────────────────────────────
        stage('Docker Build') {
            steps {
                script {
                    sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} -t ${DOCKER_IMAGE}:latest ."
                }
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                    echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                    docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                    docker push ${DOCKER_IMAGE}:latest
                    """
                }
            }
        }

        // ── 8. Deploy ───────────────────────────────────────────────────────
        stage('Deploy') {
            when {
                branch 'master'
            }
            steps {
                sh """
                docker stop pi-back || true
                docker rm   pi-back || true
                docker run -d \
                  --name pi-back \
                  --restart unless-stopped \
                  -p 3000:3000 \
                  --env-file /etc/pi-back.env \
                  ${DOCKER_IMAGE}:latest
                """
            }
        }
    }

    // ── Post actions ─────────────────────────────────────────────────────────
    post {
        success {
            echo "✅ Backend pipeline SUCCESS — build #${BUILD_NUMBER}"
        }
        failure {
            echo "❌ Backend pipeline FAILED — build #${BUILD_NUMBER}"
        }
        always {
            cleanWs()
        }
    }
}
