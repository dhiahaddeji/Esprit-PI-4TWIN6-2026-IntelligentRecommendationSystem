pipeline {
    agent any

    tools {
        nodejs "nodejs"
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    environment {
        SONARQUBE_ENV   = "sonarqube"
        SONAR_TOKEN     = credentials("sonar-token1")
        SONAR_HOST      = "http://localhost:9000"
        DOCKER_IMAGE    = "dhiahaddeji/pi-back"
        DOCKER_TAG      = "${BUILD_NUMBER}"
        BACKEND_CHANGED = "false"
    }

    stages {

        stage('Clone') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/abir-mosrati2/Esprit-PI-4TWIN6-2026-IntelligentRecommendationSystem.git'
            }
        }

        // Vérifie si des fichiers backend/ ont changé dans ce commit
        stage('Detect Changes') {
            steps {
                script {
                    def changedFiles = sh(
                        script: "git diff --name-only HEAD~1 HEAD 2>/dev/null || git diff --name-only HEAD",
                        returnStdout: true
                    ).trim()
                    echo "Changed files:\n${changedFiles}"
                    if (changedFiles.split('\n').any { it.startsWith('backend/') }) {
                        env.BACKEND_CHANGED = "true"
                        echo "✅ Backend changes detected — pipeline continues"
                    } else {
                        echo "⏭️  No backend changes — pipeline skipped"
                    }
                }
            }
        }

        stage('Install') {
            when { environment name: 'BACKEND_CHANGED', value: 'true' }
            steps {
                dir('backend') {
                    sh 'npm ci'
                }
            }
        }

        stage('Test') {
            when { environment name: 'BACKEND_CHANGED', value: 'true' }
            steps {
                dir('backend') {
                    sh 'npm run test -- --coverage --forceExit || true'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'backend/test-results/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            when { environment name: 'BACKEND_CHANGED', value: 'true' }
            steps {
                dir('backend') {
                    withSonarQubeEnv("${SONARQUBE_ENV}") {
                        sh """
                        npx sonar-scanner \
                          -Dsonar.projectKey=Backend \
                          -Dsonar.projectName="PI Backend" \
                          -Dsonar.sources=src \
                          -Dsonar.exclusions=**/node_modules/**,**/dist/**,**/*.spec.ts,**/test/** \
                          -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                          -Dsonar.host.url=${SONAR_HOST} \
                          -Dsonar.token=${SONAR_TOKEN}
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            when { environment name: 'BACKEND_CHANGED', value: 'true' }
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build') {
            when { environment name: 'BACKEND_CHANGED', value: 'true' }
            steps {
                dir('backend') {
                    sh 'npm run build'
                }
            }
        }

        stage('Docker Build') {
            when { environment name: 'BACKEND_CHANGED', value: 'true' }
            steps {
                dir('backend') {
                    sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} -t ${DOCKER_IMAGE}:latest ."
                }
            }
        }

        stage('Docker Push') {
            when { environment name: 'BACKEND_CHANGED', value: 'true' }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                    echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                    docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                    docker push ${DOCKER_IMAGE}:latest
                    """
                }
            }
        }
    }

    post {
        success {
            script {
                if (env.BACKEND_CHANGED == 'true') {
                    echo "✅ Backend CI SUCCESS — build #${BUILD_NUMBER}"
                    build job: 'backend-CD', wait: false
                }
            }
        }
        failure {
            echo "❌ Backend CI FAILED — build #${BUILD_NUMBER}"
        }
        always {
            cleanWs()
        }
    }
}
