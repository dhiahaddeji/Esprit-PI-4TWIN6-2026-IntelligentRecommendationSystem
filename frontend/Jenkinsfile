pipeline {
    agent any

    tools {
        nodejs "nodejs"
    }

    environment {
        SONARQUBE_ENV  = "sonarqube"
        SONAR_TOKEN    = credentials("sonar-token")          // Jenkins credential ID
        SONAR_HOST     = "http://localhost:9000"
        DOCKER_IMAGE   = "dhiahaddeji/pi-front"
        DOCKER_TAG     = "${BUILD_NUMBER}"
    }

    stages {

        // ── 1. Clone ────────────────────────────────────────────────────────
        stage('Clone') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/abir-mosrati2/Esprit-PI-4TWIN6-2026-IntelligentRecommendationSystem.git'
            }
        }

        // ── 2. Install ──────────────────────────────────────────────────────
        stage('Install') {
            steps {
                sh 'npm ci --include=dev'
            }
        }

        // ── 3. Tests ────────────────────────────────────────────────────────
        stage('Test') {
            steps {
                sh 'mkdir -p reports'
                sh 'npm run test -- --coverage || true'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'reports/junit.xml'
                }
            }
        }

        // ── 4. SonarQube Analysis ───────────────────────────────────────────
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv("${SONARQUBE_ENV}") {
                    sh """
                    npx sonar-scanner \
                      -Dsonar.projectKey=frontend \
                      -Dsonar.projectName="PI Frontend" \
                      -Dsonar.sources=src \
                      -Dsonar.exclusions=**/node_modules/**,**/dist/**,**/reports/**,**/*.test.*,**/*.spec.* \
                      -Dsonar.javascript.lcov.reportPaths=reports/coverage/lcov.info \
                      -Dsonar.host.url=${SONAR_HOST} \
                      -Dsonar.token=${SONAR_TOKEN}
                    """
                }
            }
        }

        // ── 5. Quality Gate ─────────────────────────────────────────────────
        stage('Quality Gate') {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ── 6. Build ────────────────────────────────────────────────────────
        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }

        // ── 7. Docker Build & Push ──────────────────────────────────────────
        stage('Docker Build') {
            steps {
                script {
                    sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} -t ${DOCKER_IMAGE}:latest ."
                }
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                    echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                    docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                    docker push ${DOCKER_IMAGE}:latest
                    """
                }
            }
        }

        // ── 8. Deploy ───────────────────────────────────────────────────────
        stage('Deploy') {
            when {
                branch 'master'
            }
            steps {
                sh """
                docker stop pi-front || true
                docker rm   pi-front || true
                docker run -d \
                  --name pi-front \
                  --restart unless-stopped \
                  -p 5173:80 \
                  ${DOCKER_IMAGE}:latest
                """
            }
        }
    }

    // ── Post actions ─────────────────────────────────────────────────────────
    post {
        success {
            echo "✅ Frontend pipeline SUCCESS — build #${BUILD_NUMBER}"
        }
        failure {
            echo "❌ Frontend pipeline FAILED — build #${BUILD_NUMBER}"
        }
        always {
            cleanWs()
        }
    }
}
