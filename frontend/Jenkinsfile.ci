pipeline {
    agent any

    triggers {
        pollSCM('H/5 * * * *')
    }

    environment {
        SONARQUBE_ENV = "sonarqube"
        SONAR_TOKEN   = credentials("sonar-token1")
        SONAR_HOST    = "http://localhost:9000"
        DOCKER_IMAGE  = "dhiahaddeji/pi-front"
        DOCKER_TAG    = "${BUILD_NUMBER}"
    }

    stages {

        stage('Clone') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/abir-mosrati2/Esprit-PI-4TWIN6-2026-IntelligentRecommendationSystem.git'
            }
        }

        stage('Install') {
            steps {
                dir('frontend') {
                    bat 'npm ci --include=dev'
                }
            }
        }

        stage('Test') {
            steps {
                dir('frontend') {
                    bat 'if not exist reports mkdir reports'
                    bat 'npm run test -- --coverage --pool=forks --reporter=verbose || exit 0'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'frontend/reports/junit.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('frontend') {
                    withSonarQubeEnv("${SONARQUBE_ENV}") {
                        bat "npx sonar-scanner -Dsonar.projectKey=frontend -Dsonar.projectName=\"PI Frontend\" -Dsonar.sources=src -Dsonar.exclusions=**/node_modules/**,**/dist/**,**/reports/**,**/*.test.*,**/*.spec.* -Dsonar.javascript.lcov.reportPaths=reports/coverage/lcov.info -Dsonar.host.url=${SONAR_HOST} -Dsonar.token=${SONAR_TOKEN}"
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build') {
            steps {
                dir('frontend') {
                    bat 'npm run build'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('frontend') {
                    bat "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} -t ${DOCKER_IMAGE}:latest ."
                }
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    bat "echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin && docker push ${DOCKER_IMAGE}:${DOCKER_TAG} && docker push ${DOCKER_IMAGE}:latest"
                }
            }
        }
    }

    post {
        success {
            echo "✅ Frontend CI SUCCESS — build #${BUILD_NUMBER}"
            build job: 'frontend-CD', wait: false
        }
        failure {
            echo "❌ Frontend CI FAILED — build #${BUILD_NUMBER}"
        }
        always {
            cleanWs()
        }
    }
}
